---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutContent from "../components/AboutContent.astro";

const description =
  "Stan Angeloff — hands-on engineer with 20+ years building production systems. AI-agent infrastructure, platform & developer experience. Based in Sofia, Bulgaria.";
---

<BaseLayout
  title="About"
  activeNav="about"
  description={description}
  ogImage={new URL("/og/default.png", Astro.site).href}
>
  <AboutContent />
</BaseLayout>
